<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LumaShot · 截图历史" Width="1280" Height="820" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#F7F8FC" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#26273A">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,10"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#494B60"/><Setter Property="BorderBrush" Value="#E4E6EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.77"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,9"/><Setter Property="Background" Value="#F7F8FC"/><Setter Property="BorderBrush" Value="#E5E7EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#9297AD"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="15,13"/></Style>
  <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#7561DF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="#F7F8FC"/><Setter Property="BorderBrush" Value="#E5E7EF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#494B60"/><Setter Property="Padding" Value="11,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="White" BorderBrush="#E4E6EF" BorderThickness="1" CornerRadius="7"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#8D83AD"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,7,30,7" VerticalAlignment="Center"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#DFD8F0" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Padding="5"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EEE9FC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#7561DF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="20,11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="#F4F2F9" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,5,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#E9E2FB"/><Setter Property="Foreground" Value="#6F54C5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#1B1D2B"><DockPanel Margin="18,26,18,18">
   <StackPanel DockPanel.Dock="Top">
    <StackPanel Orientation="Horizontal" Margin="8,0,0,32"><Border Width="34" Height="34" CornerRadius="10" Background="#8973F2"><TextBlock Text="◈" Foreground="White" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="LumaShot" FontSize="21" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="CAPTURE &amp; HISTORY" FontSize="8" Foreground="#8E93AC" Margin="1,3,0,0"/></StackPanel></StackPanel>
    <TextBlock Text="我的资料库" Foreground="#6C728C" FontSize="11" Margin="14,0,0,10"/>
    <Button x:Name="NavAll" Style="{StaticResource Nav}" Content="▦     全部记录"/>
    <Button x:Name="NavStar" Style="{StaticResource Nav}" Content="☆     我的收藏"/>
    <Button x:Name="NavImage" Style="{StaticResource Nav}" Content="▧     截图与动图"/>
    <Button x:Name="NavVideo" Style="{StaticResource Nav}" Content="▷     屏幕录制"/>
    <Border Height="1" Background="#303344" Margin="12,20"/>
    <Button x:Name="NavTrash" Style="{StaticResource Nav}" Content="♲     回收站"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom">
    <Border Background="#252838" CornerRadius="10" Padding="14" Margin="0,0,0,14"><StackPanel><TextBlock Text="本地资料库" Foreground="#CFD2E3" FontSize="12"/><TextBlock Text="原图保留 · 本地保存" Foreground="#8188A4" FontSize="10" Margin="0,7,0,0"/><TextBlock x:Name="LibrarySize" Text="你的截图资料库" Foreground="#8188A4" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
    <Button x:Name="Settings" Style="{StaticResource Nav}" Content="⚙     设置与快捷键"/>
    <Button x:Name="Quit" Style="{StaticResource Nav}" Content="退出 LumaShot" FontSize="11"/>
    <TextBlock Text="LUMASHOT  /  0.1.0" Foreground="#596079" FontSize="9" Margin="14,15,0,0"/>
   </StackPanel>
   <Grid/>
  </DockPanel></Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="102"/><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
   <Grid Margin="28,23,28,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="Heading" Text="截图历史" FontSize="27" FontWeight="SemiBold"/><Border Background="#ECE8FC" CornerRadius="5" Margin="12,4,0,4" Padding="8,4"><TextBlock x:Name="Total" Text="0" Foreground="#7963D3" FontSize="12"/></Border></StackPanel><TextBlock Text="截图、录屏和编辑历史" Foreground="#9093A5" FontSize="12" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="QuickHistory" Content="快速历史" Margin="0,0,9,0"/><Button x:Name="Import" Content="导入" Margin="0,0,9,0"/><Button x:Name="Capture" Content="＋  新建截图" Style="{StaticResource Accent}" Padding="20,12"/><Button x:Name="CaptureMenu" Content="⌄" Style="{StaticResource Accent}" Margin="4,0,0,0" Padding="11,12"/></StackPanel></Grid>
   <Grid Grid.Row="1" Margin="28,0,28,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" ToolTip="搜索标题、标签、备注或日期" FontSize="12"/><TextBlock x:Name="SearchHint" Text="⌕   搜索标题、标签、备注…" Foreground="#9296AA" Margin="13,11,0,0" IsHitTestVisible="False"/><ComboBox x:Name="DateFilter" Grid.Column="1" Width="105" Margin="12,0,0,0" VerticalContentAlignment="Center"><ComboBoxItem Content="全部时间" IsSelected="True"/><ComboBoxItem Content="今天"/><ComboBoxItem Content="最近 7 天"/><ComboBoxItem Content="最近 30 天"/></ComboBox><Button x:Name="Sort" Grid.Column="2" Content="↓  最新优先" Margin="10,0,0,0" FontSize="11"/></Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
    <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,5,16,25"><StackPanel x:Name="History"/></ScrollViewer>
    <Border Grid.Column="1" Background="White" BorderBrush="#E7E9F0" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Inspector" Margin="20,22"/></ScrollViewer></Border>
   </Grid>
   <Border Grid.Row="3" BorderBrush="#E5E7EF" BorderThickness="0,1,0,0" Background="#FDFDFF"><DockPanel Margin="28,0"><TextBlock x:Name="ShortcutHint" Text="Ctrl + Shift + 2  截图" Foreground="#9599AD" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock x:Name="Status" Text="已就绪 · 历史记录自动保存" Foreground="#9397AA" FontSize="10" VerticalAlignment="Center"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
